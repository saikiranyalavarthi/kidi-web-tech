{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx"
, "src/app/blog/[slug]/page.jsx", "src/app/admin/login/page.jsx", "src/app/blogs/page.jsx", "src/app/api/blogs/route.js", "src/app/Components/KidiWebTechChatbot.jsx", "src/app/api/chat/route.js", "src/app/corporate-training/it-audit-sox-training/page.jsx", "src/app/corporate-training/devops-with-azure/page.jsx", "src/app/corporate-training/page.jsx", "src/app/corporate-training/it-technical-certifications/page.jsx", "src/app/ai-automation/page.jsx", "src/app/graphic-design-services/page.jsx"  ],
  "exclude": ["node_modules"]
}